{
  "name": "serfing-erp",
  "version": "1.0.0",
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "module": "index.ts",
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/cz-commitlint": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "@types/bun": "latest",
    "commitizen": "^4.3.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "typescript-eslint": "^8.62.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "private": true,
  "scripts": {
    "dev": "bun --filter \"**\" dev",
    "commit": "git-cz",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "api:drizzle": "bun --filter \"api\" drizzle:push && bun --filter \"api\" drizzle:initial"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ]
}
